[Unit]
Description=Haru local vocal expression and tone analysis
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/haru-desktop/electron
ExecStart=%h/miniconda3/envs/gpt-sovits/bin/python voice-affect-server.py
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_OFFLINE=1
Environment=MODELSCOPE_OFFLINE=1
Environment=CUDA_VISIBLE_DEVICES=
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Restart=on-failure
RestartSec=3
CPUQuota=200%
MemoryMax=3G
NoNewPrivileges=true

[Install]
WantedBy=default.target
