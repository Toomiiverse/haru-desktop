{
  "name": "haru-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Haru desktop companion",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p electron/tsconfig.json && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "start": "electron .",
    "package": "npm run build && electron-builder --win --config electron-builder.config.cjs",
    "sign:dev": "node scripts/sign-dev-electron.cjs"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^6.5.10",
    "adm-zip": "0.5.16",
    "electron-store": "11.0.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "1.28.0",
    "pdfjs-dist": "^6.2.108",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "wait-on": "9.1.0"
  }
}
